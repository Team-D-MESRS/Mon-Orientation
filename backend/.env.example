# Copier vers .env et renseigner les secrets côté serveur uniquement.
DATABASE_URL=postgresql://mo_user:mo_password@localhost:5434/mon_orientation
JWT_SECRET=replace-with-a-long-random-secret
PORT=8080
CORS_ORIGIN=http://localhost:3000

# API Guido fournie. Avant tout usage réel, exposer ce service en HTTPS.
GUIDO_API_URL=http://13.140.158.110:8010
GUIDO_API_KEY=
# À activer uniquement pour un test local/dev sur un réseau de confiance; jamais en production.
GUIDO_ALLOW_INSECURE_HTTP=false

# Stockage des visuels téléversés par l’administration (MinIO/S3 compatible).
# L’URL publique doit servir le bucket en lecture anonyme uniquement pour uploads/filieres/.
# En production, MINIO_PUBLIC_URL doit être en HTTPS ; ne jamais mettre les identifiants dans Git.
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=mon-orientation-media
MINIO_PUBLIC_URL=https://media.example.bj

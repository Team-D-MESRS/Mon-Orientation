# Base de données
DATABASE_URL=postgresql://mo_user:mo_password@localhost:5434/mon_orientation

# JWT (JWT_SECRET est obligatoire : le serveur refuse de démarrer sans)
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# JWT_REFRESH_SECRET=  (facultatif, dérivé de JWT_SECRET sinon)

# Redis
REDIS_URL=redis://localhost:6381

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=mo_minio_admin
MINIO_SECRET_KEY=mo_minio_password

# EducMaster
EDUCMASTER_API_URL=https://educmaster.bj/api

# Server
PORT=8080
CORS_ORIGIN=http://localhost:3000
# true derrière un reverse proxy (nginx) pour que la limitation des tentatives voie la vraie IP
TRUST_PROXY=false

# Seed : mot de passe du compte admin (obligatoire si NODE_ENV=production)
# SEED_ADMIN_PASSWORD=

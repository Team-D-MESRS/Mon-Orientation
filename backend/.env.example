# Base de données
DATABASE_URL=postgresql://mo_user:mo_password@localhost:5434/mon_orientation

# JWT (en production : minimum 32 caractères aléatoires, jamais commité)
JWT_SECRET=dev-secret-change-in-production
JWT_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
# JWT_REFRESH_SECRET=  (facultatif, dérivé de JWT_SECRET sinon)

# MinIO
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=mo_minio_admin
MINIO_SECRET_KEY=mo_minio_password

# EducMaster
EDUCMASTER_API_URL=https://educmaster.bj/api

# Server
PORT=8080
CORS_ORIGIN=http://localhost:3000
# Plusieurs origines possibles, séparées par des virgules. Ne pas utiliser * avec credentials.
# ENABLE_SWAGGER=false en production (par défaut désactivé)
ENABLE_SWAGGER=false
# true derrière un reverse proxy (nginx) pour que la limitation des tentatives voie la vraie IP
TRUST_PROXY=false

# Seed : mot de passe du compte admin (obligatoire si NODE_ENV=production)
# SEED_ADMIN_PASSWORD=

# Conseiller pédagogique (Gemini, clé à créer sur https://aistudio.google.com). Sans clé, le conseiller répond 503 « non configuré ».
# Offre gratuite : Google peut utiliser les échanges pour améliorer ses modèles -> données de démonstration uniquement,
# jamais de données réelles d'élèves (offre payante requise).
# GEMINI_API_KEY=...
# CONSEILLER_MODELE=gemini-3.6-flash   (gemini-3.8-flash : 20 requêtes/jour seulement en offre gratuite)
# CONSEILLER_MODELE_SECOURS=gemini-3.5-flash-lite   (vide pour désactiver la bascule)
